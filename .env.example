# Copiar como .env en el servidor (chmod 600). NUNCA subir .env a GitHub.

# Nombre DNS de la máquina virtual en Azure (Paso 2.6 de la guía) o dominio propio.
DOMINIO=aikukisna.chilecentral.cloudapp.azure.com

# Orígenes que pueden llamar a la API desde el navegador (CORS), separados por coma.
# El propio dominio siempre; agrega el de la landing si se publica en otro sitio.
CORS_ORIGENES=https://aikukisna.chilecentral.cloudapp.azure.com

# Base de datos (contenedor "bd"; no se expone a internet).
POSTGRES_DB=aikukisna
POSTGRES_USER=aikukisna
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# Panel administrativo. El hash se genera con:
#   docker compose run --rm api npm run hash -- "tu-contraseña"
# Al pegarlo aquí, cada $ del hash se escribe como $$ (Docker Compose interpreta $).
ADMIN_USUARIO=admin
ADMIN_CONTRASENA_HASH=

# Firma de las sesiones del panel: openssl rand -hex 48
JWT_SECRETO=

# Tamaño máximo de un instalable (MB).
MAX_INSTALABLE_MB=1500
